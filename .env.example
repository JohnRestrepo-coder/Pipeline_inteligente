# ==============================================================================
# VARIABLES DE ENTORNO - PIPELINE INTELIGENTE FUNDACIÓN WWB
# ==============================================================================

# Directorio base de trabajo (opcional; si se omite, se usa la raíz del proyecto)
# PIPELINE_BASE_DIR=C:\Proyectos\Pipeline_inteligente

# Configuración de Ollama (IA Local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Configuración de Google Gemini (IA Nube / Fallback)
# Obtén tu clave en: https://aistudio.google.com/
GEMINI_API_KEY=tu_clave_api_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash

# Modo de motor: "auto" (Ollama con fallback a Gemini), "ollama", o "gemini"
DEFAULT_AI_ENGINE=auto

# Tiempos de espera y reintentos
LLM_TIMEOUT=120
MAX_RETRIES=3
